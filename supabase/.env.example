# Copy this file to supabase/.env and fill in real values. Never commit supabase/.env.
#
# Hosted project:
#   supabase secrets set --env-file supabase/.env
# Local stack:
#   supabase functions serve ai-generate --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the hosted runtime and the local stack; do not set them here.

# --- AI provider (any OpenAI-compatible Chat Completions API) ---
# River AI example. Keep the key server-side only: api.river.ai sends no CORS
# headers, so it cannot be called directly from the browser.
AI_API_BASE=https://api.river.ai/v1
AI_API_KEY=rv_replace_with_your_key
# Exact model id from the River Console (GET /v1/models with your key).
AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Kill switch: generation is served only when this equals the string "true".
# Enable only after a spending budget is approved.
AI_GENERATION_ENABLED=false

# --- Browser origin allow-list ---
# Exact HTTPS origin of the app, WITHOUT path and without a trailing slash.
# GitHub Pages: https://ryouta-dev.github.io
# Local HTTPS dev may use an https://localhost tool; plain http is rejected.
APP_ALLOWED_ORIGIN=https://ryouta-dev.github.io

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
APP_URL=https://ryouta-dev.github.io/SmartUstaz/
